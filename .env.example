# Copy to .env in the repository root. Secrets belong ONLY on the API server.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Enable only with HOST=127.0.0.1 behind a local proxy sanitizing forwarded headers.
TRUST_PROXY_LOOPBACK=false

# DeepSeek or another Chat Completions compatible service.
# Include /v1 in AI_BASE_URL if required by your provider; do not include /chat/completions.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_JSON_MODE=true
AI_TIMEOUT_MS=60000
# Includes reasoning and final JSON. Pro thinking mode may need 240000 ms.
AI_MAX_OUTPUT_TOKENS=16000

# Optional field overrides, highest priority first:
# exact industry-round-preference > preference > round > industry > legacy role > global.
# Each layer supports BASE_URL / API_KEY / MODEL. Keep credentials server-side.
# AI_HARDWARE_A_TECHNOLOGY_MODEL=
# AI_PREFERENCE_TECHNOLOGY_MODEL=
# AI_PREFERENCE_FINANCIAL_BASE_URL=
# AI_PREFERENCE_FINANCIAL_API_KEY=
# AI_PREFERENCE_FINANCIAL_MODEL=
# AI_ROUND_SEED_MODEL=
# AI_INDUSTRY_HARDWARE_MODEL=
# Existing AI_AI_PARTNER_*, AI_ANGEL_COACH_*, AI_FINANCE_PARTNER_* remain fallbacks.

# Required in production; generate SESSION_SECRET using a password manager (32+ random chars).
SESSION_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ACTIVE_EVALUATIONS=2
DAILY_EVALUATIONS_PER_USER=5

# Enable paid reviews only after setting all merchant credentials. Price: 188 fen.
PAYMENTS_ENABLED=false
PAYMENT_DB_PATH=./data/payments.sqlite
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify
PAY_SUPPORT_CONTACT=

# Public project sharing (off until persistent storage, disclosure and deployment are ready).
PROJECT_SHARING_ENABLED=false
CLOUD_STORAGE_ENABLED=false
# Cloud reports share the encrypted project DB; only explicit WeChat opt-in enables autosave.
PROJECT_DATABASE_PATH=.data/projects.sqlite
# 32 random bytes encoded as 64 hex characters. Keep stable and backed up; server ONLY.
PROJECT_DATA_KEY=
# Stable owner identity key (32+ characters), separate from the rotating session signing key.
OWNER_ID_SECRET=
# Optional public H5 base URL, e.g. https://pitch.example.com (no #, query or credentials).
PUBLIC_WEB_URL=
MINIPROGRAM_ENV=release

# Project access + gifts use WeChat virtual payment, separate from assessment JSAPI billing.
# Configure XML safe-mode callbacks at /api/payments/virtual/notify; no secrets in client code.
VIRTUALPAY_ENABLED=false
VIRTUALPAY_OFFER_ID=
VIRTUALPAY_APP_KEY=
WECHAT_MESSAGE_TOKEN=
WECHAT_ENCODING_AES_KEY=
# Keys are kind:amount-in-fen; values are product IDs already published at that exact price.
# New gift SKUs use gift:888 / gift:8888 / gift:88888 / gift:888888; legacy tip SKUs remain readable.
# A custom price needs a corresponding published product before it can be purchased.
VIRTUALPAY_PRODUCTS={}
# Platform collects; internal ledger charges 5% of verified receipts after refunds.
# Channel fees remain separate. No automatic payouts/refunds are implemented.
# Enable only after the actual product permissions, channel fees, refund and owner settlement plan are ready.
PROJECT_SETTLEMENT_READY=false
