# Copy to .env in the repository root. Secrets belong ONLY on the API server.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Enable only with HOST=127.0.0.1 behind a local proxy sanitizing forwarded headers.
TRUST_PROXY_LOOPBACK=false

# DeepSeek or another Chat Completions compatible service.
# Include /v1 in AI_BASE_URL if required by your provider; do not include /chat/completions.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_JSON_MODE=true
AI_TIMEOUT_MS=60000

# Optional field overrides, highest priority first:
# exact industry-round-preference > preference > round > industry > legacy role > global.
# Each layer supports BASE_URL / API_KEY / MODEL. Keep credentials server-side.
# AI_HARDWARE_A_TECHNOLOGY_MODEL=
# AI_PREFERENCE_TECHNOLOGY_MODEL=
# AI_PREFERENCE_FINANCIAL_BASE_URL=
# AI_PREFERENCE_FINANCIAL_API_KEY=
# AI_PREFERENCE_FINANCIAL_MODEL=
# AI_ROUND_SEED_MODEL=
# AI_INDUSTRY_HARDWARE_MODEL=
# Existing AI_AI_PARTNER_*, AI_ANGEL_COACH_*, AI_FINANCE_PARTNER_* remain fallbacks.

# Required in production; generate SESSION_SECRET using a password manager (32+ random chars).
SESSION_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ACTIVE_EVALUATIONS=2
DAILY_EVALUATIONS_PER_USER=5

# Enable paid reviews only after setting all merchant credentials. Price: 188 fen.
PAYMENTS_ENABLED=false
PAYMENT_DB_PATH=./data/payments.sqlite
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify
PAY_SUPPORT_CONTACT=
