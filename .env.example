# Copy to .env in the repository root. Secrets belong ONLY on the API server.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# DeepSeek or another Chat Completions compatible service.
# Include /v1 in AI_BASE_URL if required by your provider; do not include /chat/completions.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_JSON_MODE=true
AI_TIMEOUT_MS=60000

# Optional: use a different model/provider for an investor. Same pattern for all investor IDs.
# AI_AI_PARTNER_MODEL=
# AI_GROWTH_PARTNER_BASE_URL=
# AI_GROWTH_PARTNER_API_KEY=
# AI_GROWTH_PARTNER_MODEL=
# AI_FINANCE_PARTNER_MODEL=

# Required in production; generate SESSION_SECRET using a password manager (32+ random chars).
SESSION_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ACTIVE_EVALUATIONS=2
DAILY_EVALUATIONS_PER_USER=5
